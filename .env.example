# URL base de la API REST (sgrai-api) en desarrollo local
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL del servidor Socket.io para notificaciones en tiempo real
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# URL usada por los rewrites de Next.js en el servidor (proxy /api/*).
# En Docker/producción debe apuntar al backend interno (http://backend:4001).
INTERNAL_API_URL=http://localhost:3001
